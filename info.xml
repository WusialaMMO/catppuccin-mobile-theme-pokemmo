    <!-- CUSTOMIZATION OPTIONS -->
    <theme_extensions theme_extension_revision="1">

        <!-- LOGIN BACKGROUNDS -->
        <theme_extension name="Catpp-Mob-Login-Background-Extension" path="custom/login-backgrounds/bgs.xml" is_mobile="true">
            <constants>
                <constant name="catpp-mob-login-background-constant" public_name="Catpp-Mob Login Backgrounds" type="IMAGE" default_value="Clouds">

                    <!-- NO LOGIN BACKGROUND -->
                    <whitelist_value>Default Animation</whitelist_value>

                    <!-- DEFAULT PHONE WIDESCREEN OPTIONS -->
                    <whitelist_value>Clouds</whitelist_value>
                    <whitelist_value>Doraemon World</whitelist_value>
                    <whitelist_value>Eevee</whitelist_value>
                    <whitelist_value>Hatsune</whitelist_value>

                    <!-- SQUARE FOLDABLE PHONE OPTIONS -->
                    <whitelist_value>Clouds (Square)</whitelist_value>
                    <whitelist_value>Doraemon World (Square)</whitelist_value>
                    <whitelist_value>Eevee (Square)</whitelist_value>
                    <whitelist_value>Hatsune (Square)</whitelist_value>

                </constant>
            </constants>
        </theme_extension>

    </theme_extensions>

</resource>
