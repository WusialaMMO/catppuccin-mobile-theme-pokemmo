<resource name="Theme Catppuccin Mocha Mobile" version="7.1" description="A Soothing pastel theme" author="Wusiala" weblink="https://forums.pokemmo.com/index.php?/topic/186539-mobile-%F0%9F%93%B1-catppuccin-mocha-mobile/">
